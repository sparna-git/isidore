  sh:property isishapes:Document_typeScope, isishapes:Document_typeDoc, isishapes:Document_typeDc,
    isishapes:Document_title, isishapes:Document_description, isishapes:Document_creator,
    isishapes:Document_date, isishapes:Document_dctdate, isishapes:Document_contributor,
    isishapes:Document_subject, isishapes:Document_dctsubject, isishapes:Document_publisher,
    isishapes:Document_dctcoverage, isishapes:Document_coverage, isishapes:Document_relation,
    isishapes:Document_spatial, isishapes:Document_isPartOf, isishapes:Document_provenance,
    isishapes:Document_language, isishapes:Document_topic, isishapes:Document_references,
    isishapes:Document_seeAlso, isishapes:Document_similarTo, isishapes:Document_aggregates,
    isishapes:Document_identifier, isishapes:Document_format, isishapes:Document_rights,
    isishapes:Document_source, isishapes:Document_accessRights, isishapes:Document_bibliographicCitation,
    isishapes:Document_extent, isishapes:Document_isAggregatedBy, isishapes:DocOrg, isishapes:DocCol .

