isishapes:Corpus a sh:NodeShape;
  volipi:iconName "fa-duotone fa-thin fa-files";
  dcterms:identifier "Corpus";
  rdfs:label "Isidore corpus"@en, "Corpus Isidore"@fr .

isishapes:Collection a sh:NodeShape;
  volipi:iconName "fa-duotone fa-thin fa-layer-group";
  sh:targetClass isidore:Collection;
  dcterms:identifier "Collection";
  rdfs:label "Collection"@en, "Collection"@fr;
  sh:node isishapes:Corpus;
  sh:property isishapes:Collection_aggregates, isishapes:Collection_identifier, isishapes:Collection_title,
    isishapes:Collection_altLabel, isishapes:Collection_publisher, isishapes:Collection_homepage,
    isishapes:Collection_seeAlso, isishapes:Collection_logo, isishapes:Collection_description,
    isishapes:Collection_type, isishapes:Collection_isAggregatedBy, isishapes:Collection_countryCode,
    isishapes:Collection_hasPart .

isishapes:Document a sh:NodeShape;
